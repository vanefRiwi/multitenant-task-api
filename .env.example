# Copia este archivo a .env para desarrollo local:  cp .env.example .env
# Valores pensados para el PostgreSQL de docker-compose.yml. NO uses estas contraseñas
# fuera de tu máquina.
APP_ENV=local
LOG_LEVEL=INFO

DB_HOST=localhost
DB_PORT=5432
CONTROL_DB_NAME=control_db

# Administrador (superusuario del contenedor). Solo lo usa scripts/bootstrap_database.py
ADMIN_DB_USER=postgres
ADMIN_DB_PASSWORD=postgres

# Usuario de la API para control_db (lo crea el bootstrap con esta contraseña)
CENTRAL_DB_USER=app_central
CENTRAL_DB_PASSWORD=local-central-password

# Usuario de provisión de tenants (lo crea el bootstrap con esta contraseña)
PROVISIONER_DB_USER=tenant_provisioner
PROVISIONER_DB_PASSWORD=local-provisioner-password

# Secretos de los tenants: en local se guardan como JSON en esta carpeta (ignorada por git)
SECRET_PROVIDER=local
LOCAL_SECRETS_DIR=.local-secrets
TENANT_SECRET_PREFIX=multitenant-task-api/local

# Genera uno propio con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres
JWT_ISSUER=multitenant-task-api
JWT_EXPIRES_MINUTES=60
